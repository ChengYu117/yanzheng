    "inclusion_frequency": "outputs/cross_val/topk_reproducibility/topk_inclusion_frequency.csv",
    "association_matrix": "outputs/misc_full_sae_eval/functional/misc_label_mapping_filtered/latent_label_matrix.csv",
    "bootstrap_ci": "outputs/cross_val/bootstrap_ci/bootstrap_ci_by_label_latent.csv",
    "cross_quality": "outputs/cross_val/cross_quality_validation/cross_quality_auc_comparison.csv"
  },
  "outputs": {
    "stable_k_by_label": "outputs\\cross_val\\stable_topk_selection\\stable_k_by_label.csv",
    "stable_topk_latent_set": "outputs\\cross_val\\stable_topk_selection\\stable_topk_latent_set.csv",
    "stable_topk_global_union": "outputs\\cross_val\\stable_topk_selection\\stable_topk_global_union.csv",
