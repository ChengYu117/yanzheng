{
  "analysis": "stable_topk_selection",
  "config": {
    "labels": [
      "RE",
      "RES",
      "REC",
      "QU",
      "QUO",
      "QUC",
      "GI",
      "SU",
      "AF"
    ],
    "ranking_metric": "cohens_d",
    "max_k": 100,
    "auc_gap_floor": 0.01,
    "pass_rate_threshold": 0.95,
    "jaccard_p05_threshold": 0.4,
    "inclusion_stable_threshold": 0.7,
    "inclusion_boundary_threshold": 0.4,
    "cross_quality_drop_threshold": 0.05,
    "require_cross_quality_gate": false,
    "require_label_stability_gate": false
